# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
*.env
!.env.example

# Logs
logs/*
!logs/.gitkeep
*.log

# Structured pipeline data (generated at runtime)
data/*
!data/.gitkeep

# Production assets (downloaded/generated media)
assets/*
!assets/.gitkeep

# Rendered output videos
output/*
!output/.gitkeep

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
